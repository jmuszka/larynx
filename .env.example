DEBUG=false

# SERVER
PORT=8080
ALLOWED_ORIGINS=https://etymomap.com

# AUTH
# Comma-separated list of approved client bearer tokens
BEARER_TOKENS=

# Admin JWT (blog create/edit/delete). Secret used to sign/verify the token.
# Generate a token with: go run ./scripts/gen-admin-jwt
ADMIN_JWT_SECRET=
ADMIN_JWT_SUBJECT=blog-admin

# LOGGING
LOG_LEVEL=info
LOG_FILE=./larynx.log

# NEO4J GRAPH DATABASE
NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_VOLUME=./data

# SQLITE
SQLITE_PATH=./db.sqlite

# AI (OpenAI-compatible API)
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
